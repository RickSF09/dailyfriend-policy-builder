# Required. A key from a PAID Mistral workspace (console.mistral.ai), with
# Zero Data Retention requested. Keys expire: note the date when you create one.
MISTRAL_API_KEY=

# Optional (defaults shown)
# MISTRAL_MODEL=mistral-medium-latest
# LIMIT_TURNS_PER_IP_HOUR=600
# LIMIT_TAILOR_PER_IP_HOUR=60
# DAILY_TOKEN_BUDGET=4000000
# CONCURRENCY=8
# MAX_QUEUE=40
# Comma-separated. A visitor who opens the page with ?code=<one of these>
# skips the per-connection limits (a whole workshop room shares one IP).
# The daily token budget still applies.
# WORKSHOP_CODES=
